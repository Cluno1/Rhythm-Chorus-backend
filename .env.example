RHYTHM_ENVIRONMENT=development
RHYTHM_BOOTSTRAP_TOKEN=replace-with-a-long-random-token
RHYTHM_DATABASE_PATH=./var/rhythm.sqlite3
RHYTHM_V2_DATABASE_PATH=./var/rhythm-v2.sqlite3
RHYTHM_LOCAL_OBJECT_ROOT=./var/objects

# Public gateway only. Generate both values locally and never commit the result.
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
RHYTHM_PUBLIC_TOKEN_SECRET=
RHYTHM_PUBLIC_ADMIN_USERNAME=admin
# python -c 'from rhythm_metadata_api.application.device_auth import hash_admin_password; print(hash_admin_password(input("Admin password: ")))'
RHYTHM_PUBLIC_ADMIN_PASSWORD_HASH=

# Sonorus self-hosted updates. Keep the host directory writable only through
# the deployment account; public-api mounts it read-only.
RHYTHM_SONORUS_UPDATES_ROOT=./updates
RHYTHM_SONORUS_DEBUG_CERTIFICATE_SHA256=
RHYTHM_SONORUS_STABLE_CERTIFICATE_SHA256=
